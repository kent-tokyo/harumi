{
  "name": "bulk-extraction-corpus-v1",
  "version": 1,
  "inputs": [
    {
      "id": "cjk-text",
      "kind": "digital_text",
      "source": "tests/fixtures/NotoSansJP-Regular.ttf",
      "recipe": "Generate a two-page report with Japanese heading, body text, and an explicit page break.",
      "checks": ["text", "reading_order", "cjk", "page_boundary"]
    },
    {
      "id": "one-glyph-per-tj",
      "kind": "fragmented_text",
      "source": "generated by the corpus runner",
      "recipe": "Encode one glyph per Tj fragment on the same baseline, including adjacent CJK characters.",
      "checks": ["text", "reading_order", "fragment_joining", "coordinates"]
    },
    {
      "id": "two-column-report",
      "kind": "multi_column",
      "source": "generated by the corpus runner",
      "recipe": "Place two independent text columns with a three-row key/value table.",
      "checks": ["text", "column_order", "coordinates", "table_limits"]
    },
    {
      "id": "scanned-page-ocr-json",
      "kind": "scan_with_ocr_layer",
      "source": "generated by the corpus runner",
      "recipe": "Pair one page image with OCR JSON and keep image, visible text, and invisible OCR text distinct.",
      "checks": ["image_presence", "ocr_visibility", "coordinates"]
    },
    {
      "id": "generated-report",
      "kind": "generated_pdf",
      "source": "docs/fixtures/report-generation.json",
      "recipe": "Use the shared report-generation fixture as a multi-page extraction input.",
      "checks": ["text", "cjk", "table_limits", "page_boundary", "markdown"]
    }
  ],
  "metrics": [
    "page_count",
    "text_marker_recall",
    "reading_order",
    "coordinate_coverage",
    "table_boundary_preservation",
    "image_and_ocr_separation",
    "markdown_block_recall",
    "parallelism",
    "elapsed_ms",
    "peak_memory_bytes"
  ],
  "failure_classes": [
    "text_missing",
    "reading_order_changed",
    "coordinates_missing",
    "table_structure_lost",
    "image_or_ocr_mixed",
    "toc_or_markdown_block_lost",
    "rendering_difference",
    "translation_overflow",
    "fragment_joining_changed"
  ],
  "comparison_policy": "Run unpdf, pdf_oxide, and harumi against the same inputs and report each metric separately. Do not infer performance, quality, adoption, or replacement from one aggregate score."
}
